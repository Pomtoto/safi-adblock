<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C7F58A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101817</item>
        <item name="android:navigationBarColor">#101817</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#101817</item>
    </style>
    <!-- API 26 must not reference windowLightNavigationBar (introduced in API 27). -->
    <style name="AppTheme" parent="BaseAppTheme" />
</resources>
